# Salin ke .env lalu isi. File .env tidak ikut ter-commit.
# Variabel TANPA awalan VITE_ hanya dibaca server Vite, tidak masuk ke JavaScript browser.

# API key dari Google AI Studio: https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Model dipilih OTOMATIS dari daftar model yang tersedia untuk key-mu. Biarkan baris ini kosong/dikomentari
# kecuali kamu ingin memaksa satu model; nama yang salah akan membuat scan gagal.
# VITE_GEMINI_MODEL=
