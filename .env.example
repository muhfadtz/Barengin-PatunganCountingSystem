# Salin ke .env lalu isi. File .env tidak ikut ter-commit.
# Variabel TANPA awalan VITE_ hanya dibaca server Vite, tidak masuk ke JavaScript browser.

# API key dari Google AI Studio: https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Opsional: paksa satu model (default: gemini-3.6-flash, jatuh ke gemini-2.5-flash jika tidak ditemukan)
# VITE_GEMINI_MODEL=gemini-3.6-flash
