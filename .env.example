# Salin ke .env lalu isi. File .env tidak ikut ter-commit.
# Variabel TANPA awalan VITE_ hanya dibaca server Vite, tidak masuk ke JavaScript browser.

# URL Hugging Face Inference Endpoint yang menjalankan PaddleOCR-VL (tanpa /v1).
PADDLEOCR_ENDPOINT=
# Token HF (fine-grained, cukup akses baca ke endpoint, atau token Read).
HF_TOKEN=
# Opsional: nama model yang disajikan endpoint (default PaddlePaddle/PaddleOCR-VL).
# VITE_PADDLEOCR_MODEL=
