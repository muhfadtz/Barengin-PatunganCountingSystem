# Salin ke .env lalu isi. File .env tidak ikut ter-commit.
# Variabel TANPA awalan VITE_ hanya dibaca server Vite, tidak masuk ke JavaScript browser.

# Token Hugging Face (Settings -> Access Tokens).
# Dipakai untuk OCR (kuota ZeroGPU akunmu) dan LLM parser (kredit Inference Providers).
# Token fine-grained perlu izin "Make calls to Inference Providers".
HF_TOKEN=

# Opsional
# UNLIMITED_OCR_URL=https://baidu-unlimited-ocr.hf.space
# LLM_BASE_URL=https://router.huggingface.co
# VITE_LLM_MODEL=Qwen/Qwen2.5-1.5B-Instruct
